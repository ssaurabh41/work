{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest *)",
      "Bash(python3 tests/run.py)",
      "Bash(python3 tests/run.py *)",
      "Bash(node --check *)",
      "Bash(python3 -m drawlogic validate *)",
      "Bash(python3 -m drawlogic doctor)",
      "Bash(python3 -m drawlogic help)",
      "Bash(python3 -m drawlogic help *)",
      "Bash(python3 -m drawlogic symbols)",
      "Bash(python3 -m drawlogic symbols *)",
      "Bash(python3 -m drawlogic info *)",
      "Bash(npx -y impeccable install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || true"
          }
        ]
      }
    ]
  }
}
